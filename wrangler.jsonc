{
	"$schema": "https://developers.cloudflare.com/workers/wrangler/configuration-schema.json",
	"name": "gasu-3-history",
	"main": "backend/index.js",
	"compatibility_date": "2026-10-01",
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": ".",
		"run_worker_first": [
			"/api/*"
		]
	},
	"env": {
		"staging": {
			"name": "gasu-3-history-staging",
			"kv_namespaces": [
				{
					"binding": "APP_KV",
					"id": "5044ad2c6d1141cf99f3b9cfc1255f1c"
				}
			]
		}
	},
	"kv_namespaces": [
		{
			"binding": "APP_KV",
			"id": "4ac63f76e8654870ac0734cd79469e8f"
		}
	]
}